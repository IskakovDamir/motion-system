{
  "name": "motion-system",
  "version": "0.1.0",
  "private": true,
  "description": "A Remotion motion system extracted from reference videos: tokens, primitives, a showcase and a style demo.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:showcase": "remotion render src/index.ts MotionShowcase out/MotionShowcase.mp4",
    "render:demo": "remotion render src/index.ts StyleDemo out/StyleDemo.mp4",
    "typecheck": "tsc --noEmit",
    "verify": ".venv/bin/python scripts/verify.py"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/unbounded": "^5.3.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/three": "4.0.539",
    "@remotion/transitions": "4.0.539",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.539",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/three": "0.187.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
